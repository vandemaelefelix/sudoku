{
  "name": "sudoku",
  "private": true,
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "boundaries": "depcruise apps/mobile/index.ts apps/mobile/devChecks.ts apps/mobile/src packages/sudoku-core/src packages/sync-contract/src --config .dependency-cruiser.cjs",
    "typecheck:infra": "tsc -p tsconfig.infra.json"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.4",
    "dependency-cruiser": "18.5.0",
    "opentype.js": "1.3.4",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "sst": "4.17.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
