    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-intl": "12.1.3",
    "react-native": "0.86.3",
    "react-native-fast-opencv": "1.0.1",
    "react-native-fast-tflite": "3.0.1",
    "react-native-nitro-image": "0.15.2",
