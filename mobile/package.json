  "jest": {
    "moduleNameMapper": {
      "\\.tflite$": "<rootDir>/test/tfliteStub.js",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@assets/(.*)$": "<rootDir>/assets/$1"
    },
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-unistyles/mocks",
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|react-intl|@formatjs|intl-messageformat))",
