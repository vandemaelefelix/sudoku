# ML: images and runs stay out of git (ADR-009, ADR-018). ml/data/ is the old image location.
ml/data/
ml/artifacts/
data/images/
data/work/
# A write that stopped part-way leaves a .part file beside a table
data/*.part

# A model trained on real cells may not be published (ADR-013). just install-model copies it in.
mobile/assets/models/*.tflite

# Secrets
.env
.env.*

# Expo Continuous Native Generation (ADR-002)
mobile/ios/
mobile/android/

