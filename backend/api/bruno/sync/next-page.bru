meta {
  name: Sync - next page
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/sync
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "entries": [],
    "cursor": "{{cursor}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status === 200) bru.setVar("cursor", res.body.cursor);
}

docs {
  Run "Sync - full pull" first. It sets the variable `cursor`.
}
