{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "react", "jest", "vitest"],
  "jsPlugins": ["./tools/oxlint/sudoku-plugin.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.2"
    }
  },
  "ignorePatterns": ["**/dist/**", "**/.expo/**", "ml/**", ".superpowers/**", ".sst/**"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "oxc/no-barrel-file": [
      "error",
      {
        "threshold": 0
      }
    ],
    "no-warning-comments": [
      "error",
      {
        "terms": ["todo", "fixme", "xxx", "hack"]
      }
    ],
    "unicorn/no-abusive-eslint-disable": "error",
    "react/react-in-jsx-scope": "off",
    "react/style-prop-object": "off",
    "unicorn/require-module-specifiers": "off"
  },
  "overrides": [
    {
      "files": ["mobile/**"],
      "rules": {
        "import/no-relative-parent-imports": "error"
      }
    },
    {
      "files": ["mobile/**/*.ts", "mobile/**/*.tsx", "mobile/**/*.js"],
      "rules": {
        "sudoku/no-colour-literal": "error"
      }
    },
    {
      "files": ["mobile/src/theme/**"],
      "rules": {
        "sudoku/no-colour-literal": "off"
      }
    },
    {
      "files": ["mobile/src/**/*.tsx", "mobile/src/**/*.ts"],
      "rules": {
        "sudoku/no-literal-text": "error"
      }
    },
    {
      "files": [
        "mobile/src/scan/components/DevMenu/**",
        "mobile/src/scan/components/ScanInspector/**",
        "mobile/src/scan/components/ThresholdSlider/**",
        "mobile/src/scan/effects/**",
        "mobile/src/stats/components/ResetStats/**",
        "mobile/src/**/*.test.tsx",
        "mobile/src/**/*.test.ts"
      ],
      "rules": {
        "sudoku/no-literal-text": "off"
      }
    },
    {
      "files": ["mobile/src/**/*.constants.ts"],
      "rules": {
        "sudoku/no-constant-text": "error"
      }
    },
    {
      "files": [
        "mobile/src/scan/components/DevMenu/**",
        "mobile/src/scan/components/ScanInspector/**",
        "mobile/src/scan/effects/**",
        "mobile/src/scan/components/CorrectionCheck/CorrectionCheck.constants.ts"
      ],
      "rules": {
        "sudoku/no-constant-text": "off"
      }
    }
  ]
}
